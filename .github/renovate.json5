{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':configMigration',
    ':pinDevDependencies',
    'abandonments:recommended',
    'security:minimumReleaseAgeNpm',
    ':maintainLockFilesWeekly',
  ],
  dependencyDashboard: {
    enabled: false,
  },
  dependencyDashboardApproval: false,
  automerge: false,
  timezone: 'America/New_York',
  rangeStrategy: 'bump',
  pinDigests: false,
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  labels: [
    'dependencies',
  ],
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'on monday',
    ],
  },
  packageRules: [
    {
      matchManagers: [
        'cargo',
      ],
      addLabels: [
        'rust',
      ],
      semanticCommitType: 'fix',
    },
    {
      description: 'Non-major Rust crate updates: batch, run daily',
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Rust non-major dependencies',
      schedule: [
        '* 0-5 * * *',
      ],
    },
    {
      description: 'Non-major docs (npm/bun) updates: batch, run daily',
      matchManagers: [
        'bun',
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Docs non-major dependencies',
      schedule: [
        '* 0-5 * * *',
      ],
    },
    {
      description: 'Major Rust/docs updates: open a PR every other day',
      matchManagers: [
        'cargo',
        'bun',
        'npm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      schedule: [
        '* 0-5 */2 * *',
      ],
    },
    {
      description: 'Group GitHub Actions updates, run daily',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      groupName: 'GitHub Actions',
      schedule: [
        '* 0-5 * * *',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchDepTypes: [
        'container',
        'service',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
    {
      description: 'Non-major CI tool version bumps: run daily',
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'casey/just',
        'goreleaser/nfpm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Build tools',
      schedule: [
        '* 0-5 * * *',
      ],
    },
    {
      description: 'The static build stays on 4.x, where imgproc needs only core; each bump also needs its SHA256 in scripts/build-opencv.sh',
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'opencv/opencv',
      ],
      allowedVersions: '<5',
    },
    {
      description: 'Pin GitHub Actions to commit SHAs so a moved tag cannot change code that sees release secrets; Renovate keeps the SHA and its version comment current',
      matchManagers: [
        'github-actions',
      ],
      matchDepTypes: [
        'action',
      ],
      pinDigests: true,
    },
    {
      description: 'Never pin container images to a digest. docker:pinDigests is deliberately left out of extends above; these rules are the backstop in case it ever comes back, and they are last in packageRules so they override anything a preset sets',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      pinDigests: false,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchDepTypes: [
        'container',
        'service',
      ],
      pinDigests: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        '/^packaging/docker/Dockerfile\\.build$/',
      ],
      matchStrings: [
        '(?:^|\\n)[ \\t]*(?:ARG[ \\t]+)?JUST_VERSION[ \\t]*[:=][ \\t]*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'casey/just',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
      extractVersionTemplate: '^v?(?<version>\\d+\\.\\d+\\.\\d+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        '/^packaging/docker/Dockerfile\\.build$/',
      ],
      matchStrings: [
        '(?:^|\\n)[ \\t]*(?:ARG[ \\t]+)?NFPM_VERSION[ \\t]*[:=][ \\t]*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'goreleaser/nfpm',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
      extractVersionTemplate: '^v?(?<version>\\d+\\.\\d+\\.\\d+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '(?:^|\\n)ort_openvino_version[ \\t]*:=[ \\t]*env\\("ORT_OPENVINO_VERSION",[ \\t]*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"\\)',
      ],
      depNameTemplate: 'onnxruntime-openvino',
      datasourceTemplate: 'pypi',
      versioningTemplate: 'pep440',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '(?:^|\\n)ort_version[ \\t]*:=[ \\t]*env\\("ORT_VERSION",[ \\t]*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"\\)',
      ],
      depNameTemplate: 'Microsoft.ML.OnnxRuntime',
      datasourceTemplate: 'nuget',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '(?:^|\\n)opencv_version[ \\t]*:=[ \\t]*env\\("OPENCV_VERSION",[ \\t]*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"\\)',
      ],
      depNameTemplate: 'opencv/opencv',
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'semver',
    },
  ],
}
