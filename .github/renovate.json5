{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly",
  ],

  // Keep update PRs without creating a persistent dashboard issue.
  "dependencyDashboard": false,
  "dependencyDashboardApproval": false,
  "automerge": false,
  "timezone": "America/New_York",
  "rangeStrategy": "bump",
  "pinDigests": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",

  // Nix support requires explicit opt-in.
  "nix": { "enabled": true },

  // Weekly, but unrestricted within the day so a run cannot miss the window.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"],
  },

  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"],
      "semanticCommitType": "fix",
    },
    {
      "description": "Non-major Rust crate updates: batch, run daily",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust non-major dependencies",
      "schedule": ["* 0-5 * * *"],
    },
    {
      "description": "Non-major docs (npm/bun) updates: batch, run daily",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Docs non-major dependencies",
      "schedule": ["* 0-5 * * *"],
    },
    {
      "description": "Major Rust/docs updates: open a PR every other day",
      "matchManagers": ["cargo", "bun", "npm"],
      "matchUpdateTypes": ["major"],
      "schedule": ["* 0-5 */2 * *"],
    },
    {
      "description": "Group GitHub Actions updates, run daily",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "GitHub Actions",
      "schedule": ["* 0-5 * * *"],
    },
    {
      // Distro versions identify package targets and must change with their matrix metadata.
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["container", "service"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false,
    },
    {
      "description": "Non-major CI tool version bumps: run daily",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["casey/just", "goreleaser/nfpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Build tools",
      "schedule": ["* 0-5 * * *"],
    },
    {
      "description": "Never pin actions or container images to a digest. The presets that do this, helpers:pinGitHubActionDigests and docker:pinDigests, are deliberately left out of extends above; this rule is the backstop in case they ever come back, and it is last in packageRules so it overrides anything a preset sets",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "pinDigests": false,
    },
  ],

  // These release versions live in scripts instead of package manifests.
  // Capturing only the numeric version preserves the existing optional v prefix.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^packaging/docker/Dockerfile\\.build$/",
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*(?:ARG[ \\t]+)?JUST_VERSION[ \\t]*[:=][ \\t]*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      "depNameTemplate": "casey/just",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^packaging/docker/Dockerfile\\.build$/",
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*(?:ARG[ \\t]+)?NFPM_VERSION[ \\t]*[:=][ \\t]*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      "depNameTemplate": "goreleaser/nfpm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*ORT_OPENVINO_VERSION[ \\t]*:[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      "depNameTemplate": "onnxruntime-openvino",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "(?:^|\\n)ort_version[ \\t]*:=[ \\t]*env\\(\"ORT_VERSION\",[ \\t]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\)",
      ],
      "depNameTemplate": "microsoft/onnxruntime",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
  ],
}
