msgstr "Отмена"

msgid "Done"
msgstr "Готово"

msgid "Cancel Enrollment?"
msgstr "Отменить регистрацию?"

msgid "This will discard any partial captures."
msgstr "Незавершённые снимки будут удалены."

msgid "Resume"
msgstr "Продолжить"

msgid "Discard"
msgstr "Удалить"

msgid "Delete Face"
msgstr "Удалить лицо"

msgid "Delete “%1”? You can add it again later."
msgstr "Удалить «%1»? Позже его можно будет добавить снова."

