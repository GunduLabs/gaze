msgstr "Hauteur"

msgid "Force IR emitter"
msgstr "Forcer l’émetteur IR"

msgid "Override emitter control, only if the IR emitter stays off on its own"
msgstr "Remplace le contrôle de l’émetteur, uniquement si l’émetteur IR ne s’allume pas de lui-même"

msgid "Parallel RGB + IR capture"
msgstr "Capture RGB + IR en parallèle"

msgid "Faster hybrid authentication, but some webcams cannot stream both sensors at once"
msgstr "Authentification hybride plus rapide, mais certaines webcams ne peuvent pas diffuser les deux capteurs à la fois"

msgid "Never (capture RGB, then IR)"
msgstr "Jamais (capture RGB, puis IR)"

msgid "Auto (parallel when the camera allows it)"
msgstr "Automatique (en parallèle si la caméra le permet)"

msgid "Always (capture RGB and IR at once)"
msgstr "Toujours (capture RGB et IR en même temps)"

msgid "Darkness cutoff"
msgstr "Seuil d’obscurité"

msgid "Reject frames below this mean brightness (0–255)"
msgstr "Rejette les images sous cette luminosité moyenne (0–255)"

msgid "Enrollment"
msgstr "Enregistrement"

msgid "Maximum templates"
msgstr "Nombre maximal de modèles"

msgid "Number of capture sets stored per face"
msgstr "Nombre de jeux de captures conservés par visage"

msgid "Minimum face size ratio"
msgstr "Rapport minimal de taille du visage"

msgid "Smallest accepted face during enrollment; lower allows more distance"
msgstr "Plus petit visage accepté à l’enregistrement ; une valeur plus basse permet plus de distance"

msgid "Liveness Anti-Spoofing"
msgstr "Détection du vivant (anti-usurpation)"

msgid "Enable liveness spoof prevention"
msgstr "Activer la prévention d’usurpation par détection du vivant"

msgid "Check camera images and natural movement for signs of a photo or screen"
msgstr "Recherche des signes de photo ou d’écran dans les images de la caméra et les mouvements naturels"

msgid "Liveness threshold"
msgstr "Seuil de détection du vivant"

msgid "Minimum spoof prevention confidence"
msgstr "Confiance minimale de la prévention d’usurpation"

msgid "Maximum liveness duration"
msgstr "Durée maximale de la détection du vivant"

msgid "Maximum seconds analyzed for liveness verification"
msgstr "Nombre maximal de secondes analysées pour la détection du vivant"

msgid "Authentication"
msgstr "Authentification"

msgid "Abort if SSH"
msgstr "Abandonner en cas de SSH"

msgid "Prevent authentication over SSH connections"
msgstr "Empêche l’authentification sur les connexions SSH"

msgid "Abort if lid closed"
msgstr "Abandonner si le capot est fermé"

msgid "Prevent authentication when the laptop lid is closed"
msgstr "Empêche l’authentification lorsque le capot de l’ordinateur portable est fermé"

msgid "Require a suspend first"
msgstr "Exiger d’abord une mise en veille"

msgid "Prevent authentication until the system has suspended and resumed once"
msgstr "Empêche l’authentification tant que le système n’a pas été mis en veille puis réveillé une fois"

msgid "Require confirmation on lock screen"
msgstr "Exiger une confirmation sur l’écran de verrouillage"

msgid "On KDE lock/login screens this requires your password instead of face unlock. Confirmation after a match is available on other supported surfaces"
msgstr "Sur les écrans de verrouillage et de connexion de KDE, cette option exige votre mot de passe à la place du déverrouillage facial. La confirmation après une correspondance est disponible sur les autres interfaces prises en charge"

msgid "Require confirmation for elevated authentication"
msgstr "Exiger une confirmation pour l’authentification avec privilèges"

msgid "Require pressing Enter or clicking OK to authorize after face matches for sudo, polkit, and similar prompts"
msgstr "Exige d’appuyer sur Entrée ou de cliquer sur OK pour autoriser après la correspondance du visage pour sudo, polkit et les demandes similaires"

msgid "Resume grace period (ms)"
msgstr "Délai de grâce au réveil (ms)"

msgid "Delay face authentication on wake from suspend"
msgstr "Retarde l’authentification faciale à la sortie de veille"

msgid "Start delay (ms)"
msgstr "Délai de démarrage (ms)"

msgid "Use 3000–5000 ms to give yourself time to step away after locking"
msgstr "Utilisez 3000–5000 ms pour avoir le temps de vous éloigner après le verrouillage"

msgid "Start delay applies to"
msgstr "Le délai de démarrage s’applique à"

msgid "Which prompts wait for the start delay"
msgstr "Demandes qui attendent le délai de démarrage"

msgid "All face authentication (including sudo)"
msgstr "Toute authentification faciale (y compris sudo)"

msgid "Screen lockers only"
msgstr "Verrouillages d’écran uniquement"

msgid "Storage"
msgstr "Stockage"

msgid "Encrypt face templates"
msgstr "Chiffrer les modèles de visage"

msgid "Encrypt face templates at rest with a TPM-sealed key"
msgstr "Chiffre les modèles de visage stockés avec une clé scellée par le TPM"

msgid "Unlock GNOME Keyring"
msgstr "Déverrouiller GNOME Keyring"

msgid "Use an enrolled password after liveness-protected GDM or greetd face login"
msgstr "Utilise un mot de passe enregistré après une connexion faciale GDM ou greetd protégée par la détection du vivant"

msgid "Unlock KWallet"
msgstr "Déverrouiller KWallet"

msgid "Use an enrolled password after liveness-protected KDE login; enroll with gaze keyring --kwallet"
msgstr "Utilise un mot de passe enregistré après une connexion KDE protégée par la détection du vivant ; enregistrez-le avec gaze keyring --kwallet"

