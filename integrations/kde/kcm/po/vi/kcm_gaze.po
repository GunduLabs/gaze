msgid "The Gaze daemon is not running yet. Its first start downloads face models, which can take a few minutes. This page updates when it is ready."
msgstr "Dịch vụ Gaze chưa chạy. Lần khởi động đầu tiên sẽ tải các mô hình khuôn mặt, có thể mất vài phút. Trang này sẽ cập nhật khi dịch vụ sẵn sàng."

msgid "Face the camera"
msgstr "Nhìn thẳng vào camera"

msgid "Tilt your face slightly up"
msgstr "Nghiêng mặt lên trên một chút"

msgid "Tilt your face slightly down"
msgstr "Nghiêng mặt xuống dưới một chút"

msgid "Turn your face slightly left"
msgstr "Quay mặt sang trái một chút"

msgid "Turn your face slightly right"
msgstr "Quay mặt sang phải một chút"

msgid "Captured"
msgstr "Đã chụp"

msgid "Enrollment complete"
msgstr "Đăng ký hoàn tất"

msgid "Enrollment cancelled"
msgstr "Đã hủy đăng ký"

msgid "Database error during enrollment"
msgstr "Lỗi cơ sở dữ liệu khi đăng ký"

msgid "Camera error during enrollment"
msgstr "Lỗi camera khi đăng ký"

msgid "Please look at the camera..."
msgstr "Vui lòng nhìn vào camera…"

msgid "Need more light..."
msgstr "Cần thêm ánh sáng…"

msgid "Face is clipped. Please move back..."
msgstr "Khuôn mặt bị cắt. Vui lòng lùi ra xa…"

msgid "Please center your face..."
msgstr "Vui lòng đưa khuôn mặt vào giữa…"

msgid "Please come closer..."
msgstr "Vui lòng lại gần hơn…"

msgid "Please back up..."
msgstr "Vui lòng lùi ra xa…"

msgid "Hold still..."
msgstr "Giữ yên…"

msgid "Face authentication could not run"
msgstr "Không thể chạy xác thực khuôn mặt"

msgid "Face not recognized"
msgstr "Không nhận dạng được khuôn mặt"

msgid "Too dark for face authentication"
msgstr "Quá tối để xác thực khuôn mặt"

msgid "No face detected"
msgstr "Không phát hiện khuôn mặt"

msgid "Move your face into the frame and try again"
msgstr "Hãy đưa khuôn mặt vào khung hình và thử lại"

msgid "Starting enrollment…"
msgstr "Đang bắt đầu đăng ký…"

msgid "Enrollment finished without saving."
msgstr "Đăng ký kết thúc mà không lưu."

msgid "%1 [%2s]"
msgstr "%1 [%2s]"

msgid "Could not restart the Gaze service (%1)"
msgstr "Không thể khởi động lại dịch vụ Gaze (%1)"

msgid "The Gaze service did not start again after the restart"
msgstr "Dịch vụ Gaze không chạy lại sau khi khởi động lại"

msgid "Re-enroll faces after this change?"
msgstr "Đăng ký lại khuôn mặt sau thay đổi này?"

msgid "Existing captures cannot match with the new recognition model. They remain on disk. After saving, use Improve this face for each profile, then test recognition."
msgstr "Các ảnh chụp hiện có không thể khớp với mô hình nhận dạng mới. Chúng vẫn còn trên đĩa. Sau khi lưu, hãy dùng “Cải thiện khuôn mặt này” cho từng hồ sơ, sau đó kiểm tra nhận dạng."

msgid "Standard"
msgstr "Tiêu chuẩn"

msgid "Accurate"
msgstr "Chính xác"

msgid "Settings"
msgstr "Cài đặt"

msgid "Everyday settings"
msgstr "Cài đặt cơ bản"

msgid "Advanced settings"
msgstr "Cài đặt nâng cao"

msgid "Restart Service"
msgstr "Khởi động lại dịch vụ"

msgid "Settings are locked"
msgstr "Cài đặt đang bị khóa"

msgid "Unlock…"
msgstr "Mở khóa…"

msgid "Settings saved. Restart the Gaze service to use the new inference provider."
msgstr "Đã lưu cài đặt. Khởi động lại dịch vụ Gaze để dùng trình suy luận mới."

msgid "Restarting the Gaze service…"
msgstr "Đang khởi động lại dịch vụ Gaze…"

msgid "Gaze service restarted"
msgstr "Đã khởi động lại dịch vụ Gaze"

msgid "Restarting the Gaze service failed"
msgstr "Khởi động lại dịch vụ Gaze thất bại"

msgid "Security"
msgstr "Bảo mật"

msgid "Security level"
msgstr "Mức bảo mật"

msgid "Medium is recommended. Changing the recognition model requires new captures for existing profiles"
msgstr "Nên dùng mức Trung bình. Khi đổi mô hình nhận dạng, các hồ sơ hiện có cần được chụp mới"

msgid "Low"
msgstr "Thấp"

msgid "Medium"
msgstr "Trung bình"

msgid "High"
msgstr "Cao"

msgid "Maximum"
msgstr "Tối đa"

msgid "Custom"
msgstr "Tùy chỉnh"

msgid "Detector level"
msgstr "Mức phát hiện"

msgid "Recognizer level"
msgstr "Mức nhận dạng"

msgid "RGB recognizer threshold"
msgstr "Ngưỡng nhận dạng RGB"

msgid "Minimum RGB similarity for a match"
msgstr "Độ tương đồng RGB tối thiểu để khớp"

msgid "IR recognizer threshold"
msgstr "Ngưỡng nhận dạng IR"

msgid "Minimum IR similarity for a match"
msgstr "Độ tương đồng IR tối thiểu để khớp"

msgid "Hybrid combining policy"
msgstr "Chính sách kết hợp"

msgid "Combining policy when both RGB and IR cameras are active"
msgstr "Chính sách kết hợp khi cả camera RGB và IR đều hoạt động"

msgid "Default"
msgstr "Mặc định"

msgid "Or"
msgstr "Hoặc"

msgid "Fallback on dark"
msgstr "Chuyển sang dự phòng khi tối"

msgid "And"
msgstr "Và"

msgid "Hardware"
msgstr "Phần cứng"

msgid "Inference execution provider"
msgstr "Trình thực thi suy luận"

msgid "CPU, automatic NPU, Intel OpenVINO, or AMD Ryzen AI"
msgstr "CPU, NPU tự động, Intel OpenVINO hoặc AMD Ryzen AI"

msgid "CPU"
msgstr "CPU"

msgid "Automatic (NPU)"
msgstr "Tự động (NPU)"

msgid "Intel OpenVINO"
msgstr "Intel OpenVINO"

msgid "AMD Ryzen AI"
msgstr "AMD Ryzen AI"

msgid "OpenVINO inference device"
msgstr "Thiết bị suy luận OpenVINO"

msgid "The Intel device used for all ONNX models"
msgstr "Thiết bị Intel dùng cho tất cả mô hình ONNX"

msgid "GPU"
msgstr "GPU"

msgid "NPU"
msgstr "NPU"

msgid "RGB camera source"
msgstr "Nguồn camera RGB"

msgid "Primary camera"
msgstr "Camera chính"

msgid "None (IR only)"
msgstr "Không có (chỉ IR)"

msgid "IR camera source"
msgstr "Nguồn camera IR"

msgid "None"
msgstr "Không có"

msgid "IR frame size override"
msgstr "Ép kích thước khung hình IR"

msgid "Force one resolution if the IR feed is green or corrupted on auto"
msgstr "Ép dùng một độ phân giải nếu hình IR bị xanh lá hoặc bị lỗi ở chế độ tự động"

msgid "Width"
msgstr "Chiều rộng"

msgid "Height"
msgstr "Chiều cao"

msgid "Force IR emitter"
msgstr "Ép bật đèn phát IR"

msgid "Override emitter control, only if the IR emitter stays off on its own"
msgstr "Ghi đè điều khiển đèn phát, chỉ khi đèn phát IR không tự bật"

msgid "Parallel RGB + IR capture"
msgstr "Chụp RGB + IR song song"

msgid "Faster hybrid authentication, but some webcams cannot stream both sensors at once"
msgstr "Xác thực kết hợp nhanh hơn, nhưng một số webcam không thể truyền đồng thời từ cả hai cảm biến"

msgid "Never (capture RGB, then IR)"
msgstr "Không bao giờ (chụp RGB rồi đến IR)"

msgid "Auto (parallel when the camera allows it)"
msgstr "Tự động (song song khi camera cho phép)"

msgid "Always (capture RGB and IR at once)"
msgstr "Luôn luôn (chụp RGB và IR cùng lúc)"

msgid "Darkness cutoff"
msgstr "Ngưỡng tối"

msgid "Reject frames below this mean brightness (0–255)"
msgstr "Loại bỏ khung hình có độ sáng trung bình thấp hơn mức này (0–255)"

msgid "Enrollment"
msgstr "Đăng ký"

msgid "Maximum templates"
msgstr "Số mẫu tối đa"

msgid "Number of capture sets stored per face"
msgstr "Số bộ ảnh chụp được lưu cho mỗi khuôn mặt"

msgid "Minimum face size ratio"
msgstr "Tỷ lệ kích thước khuôn mặt tối thiểu"

msgid "Smallest accepted face during enrollment; lower allows more distance"
msgstr "Khuôn mặt nhỏ nhất được chấp nhận khi đăng ký; giá trị thấp hơn cho phép ngồi xa hơn"

msgid "Liveness Anti-Spoofing"
msgstr "Phát hiện thực thể sống chống giả mạo"

msgid "Enable liveness spoof prevention"
msgstr "Bật chống giả mạo bằng phát hiện thực thể sống"

msgid "Check camera images and natural movement for signs of a photo or screen"
msgstr "Kiểm tra hình ảnh camera và chuyển động tự nhiên để tìm dấu hiệu của ảnh chụp hoặc màn hình"

msgid "Liveness threshold"
msgstr "Ngưỡng phát hiện thực thể sống"

msgid "Minimum spoof prevention confidence"
msgstr "Độ tin cậy tối thiểu khi chống giả mạo"

msgid "Maximum liveness duration"
msgstr "Thời gian phát hiện thực thể sống tối đa"

msgid "Maximum seconds analyzed for liveness verification"
msgstr "Số giây tối đa được phân tích khi phát hiện thực thể sống"

msgid "Authentication"
msgstr "Xác thực"

msgid "Abort if SSH"
msgstr "Hủy nếu là SSH"

msgid "Prevent authentication over SSH connections"
msgstr "Ngăn xác thực qua kết nối SSH"

msgid "Abort if lid closed"
msgstr "Hủy nếu nắp máy đóng"

msgid "Prevent authentication when the laptop lid is closed"
msgstr "Ngăn xác thực khi nắp máy tính xách tay đang đóng"

msgid "Require a suspend first"
msgstr "Yêu cầu tạm ngưng trước"

msgid "Prevent authentication until the system has suspended and resumed once"
msgstr "Ngăn xác thực cho đến khi hệ thống đã tạm ngưng và tiếp tục một lần"

msgid "Require confirmation on lock screen"
msgstr "Yêu cầu xác nhận trên màn hình khóa"

msgid "On KDE lock/login screens this requires your password instead of face unlock. Confirmation after a match is available on other supported surfaces"
msgstr "Trên màn hình khóa/đăng nhập của KDE, tùy chọn này yêu cầu mật khẩu thay cho mở khóa bằng khuôn mặt. Ở những nơi khác được hỗ trợ, bạn có thể xác nhận sau khi khớp"

msgid "Require confirmation for elevated authentication"
msgstr "Yêu cầu xác nhận khi xác thực với quyền cao hơn"

msgid "Require pressing Enter or clicking OK to authorize after face matches for sudo, polkit, and similar prompts"
msgstr "Yêu cầu nhấn Enter hoặc bấm OK để cho phép sau khi khuôn mặt khớp với sudo, polkit và các yêu cầu tương tự"

msgid "Resume grace period (ms)"
msgstr "Thời gian chờ sau khi tiếp tục (ms)"

msgid "Delay face authentication on wake from suspend"
msgstr "Trì hoãn xác thực khuôn mặt khi thức dậy từ trạng thái tạm ngưng"

msgid "Start delay (ms)"
msgstr "Độ trễ bắt đầu (ms)"

msgid "Use 3000–5000 ms to give yourself time to step away after locking"
msgstr "Dùng 3000–5000 ms để có thời gian rời đi sau khi khóa"

msgid "Start delay applies to"
msgstr "Độ trễ bắt đầu áp dụng cho"

msgid "Which prompts wait for the start delay"
msgstr "Những yêu cầu nào chờ độ trễ bắt đầu"

msgid "All face authentication (including sudo)"
msgstr "Mọi xác thực khuôn mặt (kể cả sudo)"

msgid "Screen lockers only"
msgstr "Chỉ các trình khóa màn hình"

msgid "Storage"
msgstr "Lưu trữ"

msgid "Encrypt face templates"
msgstr "Mã hóa mẫu khuôn mặt"

msgid "Encrypt face templates at rest with a TPM-sealed key"
msgstr "Mã hóa các mẫu khuôn mặt được lưu bằng khóa được TPM niêm phong"

msgid "Unlock GNOME Keyring"
msgstr "Mở khóa GNOME Keyring"

msgid "Use an enrolled password after liveness-protected GDM or greetd face login"
msgstr "Dùng mật khẩu đã đăng ký sau khi đăng nhập bằng khuôn mặt qua GDM hoặc greetd có phát hiện thực thể sống"

msgid "Unlock KWallet"
msgstr "Mở khóa KWallet"

msgid "Use an enrolled password after liveness-protected KDE login; enroll with gaze keyring --kwallet"
msgstr "Dùng mật khẩu đã đăng ký sau khi đăng nhập KDE có phát hiện thực thể sống; đăng ký bằng gaze keyring --kwallet"

msgid "Enrolled Faces"
msgstr "Khuôn mặt đã đăng ký"

msgid "Configure"
msgstr "Cấu hình"

msgid "Configure Gaze"
msgstr "Cấu hình Gaze"

msgid "Test"
msgstr "Kiểm tra"

msgid "Test face authentication"
msgstr "Kiểm tra xác thực khuôn mặt"

msgid "Add Face…"
msgstr "Thêm khuôn mặt…"

msgid "Enroll a new face"
msgstr "Đăng ký khuôn mặt mới"

msgid "Faces enrolled for %1"
msgstr "Các khuôn mặt đã đăng ký cho %1"

msgid "Look at the camera…"
msgstr "Hãy nhìn vào camera…"

msgid "Face recognized"
msgstr "Đã nhận dạng khuôn mặt"

msgid "No face seen before the test timed out"
msgstr "Không thấy khuôn mặt nào trước khi hết thời gian kiểm tra"

msgid "No Faces Enrolled"
msgstr "Chưa đăng ký khuôn mặt nào"

msgid "Enroll a face to get started"
msgstr "Hãy đăng ký khuôn mặt để bắt đầu"

