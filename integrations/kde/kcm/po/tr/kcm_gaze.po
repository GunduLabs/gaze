msgid "The Gaze daemon is not running yet. Its first start downloads face models, which can take a few minutes. This page updates when it is ready."
msgstr "Gaze hizmeti henüz çalışmıyor. İlk başlatmada yüz modelleri indirilir, bu birkaç dakika sürebilir. Hizmet hazır olduğunda bu sayfa güncellenir."

msgid "Face the camera"
msgstr "Doğrudan kameraya bakın"

msgid "Tilt your face slightly up"
msgstr "Yüzünüzü hafifçe yukarı eğin"

msgid "Tilt your face slightly down"
msgstr "Yüzünüzü hafifçe aşağı eğin"

msgid "Turn your face slightly left"
msgstr "Yüzünüzü hafifçe sola çevirin"

msgid "Turn your face slightly right"
msgstr "Yüzünüzü hafifçe sağa çevirin"

msgid "Captured"
msgstr "Çekildi"

msgid "Enrollment complete"
msgstr "Kayıt tamamlandı"

msgid "Enrollment cancelled"
msgstr "Kayıt iptal edildi"

