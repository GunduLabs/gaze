msgid "Behavior"
msgstr "Davranış"

msgid "Face authentication"
msgstr "Yüz kimlik doğrulaması"

msgid "Enable face authentication (lock screen)"
msgstr "Yüz kimlik doğrulamasını etkinleştir (kilit ekranı)"

msgid "Face retry mode"
msgstr "Yüz yeniden deneme kipi"

msgid "Disabled"
msgstr "Devre dışı"

msgid "Fixed tries"
msgstr "Sabit deneme sayısı"

msgid "Infinite"
msgstr "Sınırsız"

msgid "Maximum face tries"
msgstr "En fazla yüz denemesi"

msgid "Face authentication for unlocking this session. This does not affect the login screen. Settings are stored in this extension's configuration."
msgstr "Bu oturumun kilidini açmak için yüz kimlik doğrulaması. Oturum açma ekranını etkilemez. Ayarlar bu eklentinin yapılandırmasında saklanır."

msgid "Cinnamon extension for Gaze face authentication and PolKit confirmation"
msgstr "Gaze yüz kimlik doğrulaması ve PolKit onayı için Cinnamon eklentisi"

msgid "Face not recognized. Please enter your password."
msgstr "Yüz tanınmadı. Lütfen parolanızı girin."

msgid "Face not detected. Please enter your password."
msgstr "Yüz algılanmadı. Lütfen parolanızı girin."

msgid "Too dark for face authentication. Please enter your password."
msgstr "Yüz kimlik doğrulaması için çok karanlık. Lütfen parolanızı girin."

msgid "Face authentication timed out. Please enter your password."
msgstr "Yüz kimlik doğrulaması zaman aşımına uğradı. Lütfen parolanızı girin."

msgid "Face authentication unavailable. Please enter your password."
msgstr "Yüz kimlik doğrulaması kullanılamıyor. Lütfen parolanızı girin."

msgid "Changing Gaze's settings or faces needs your password."
msgstr "Gaze ayarlarını veya yüzlerini değiştirmek için parolanız gerekiyor."

msgid "Sorry, face authentication did not work. Please try again."
msgstr "Üzgünüz, yüz kimlik doğrulaması başarısız oldu. Lütfen yeniden deneyin."

msgid "You reached the maximum face authentication attempts, please try another method"
msgstr "En fazla yüz kimlik doğrulama denemesine ulaştınız, lütfen başka bir yöntem deneyin"

msgid "(or look at the camera)"
msgstr "(veya kameraya bakın)"

msgid "Password"
msgstr "Parola"

msgid "Face verified. Press Enter or click Authenticate to confirm."
msgstr "Yüz doğrulandı. Onaylamak için Enter’a basın veya Kimlik Doğrulama’ya tıklayın."

msgid "Face authentication failed"
msgstr "Yüz kimlik doğrulaması başarısız oldu"

msgid "Face authentication failed. Please enter your password."
msgstr "Yüz kimlik doğrulaması başarısız oldu. Lütfen parolanızı girin."

msgid "Confirm Face Unlock"
msgstr "Yüzle Kilit Açmayı Onayla"

msgid "Please look at the camera..."
msgstr "Lütfen kameraya bakın…"

msgid "Need more light..."
msgstr "Daha fazla ışık gerekiyor…"

msgid "Face is clipped. Please move back..."
msgstr "Yüz kesilmiş. Lütfen geri çekilin…"

msgid "Please center your face..."
msgstr "Lütfen yüzünüzü ortalayın…"

msgid "Please come closer..."
msgstr "Lütfen yaklaşın…"

msgid "Please back up..."
msgstr "Lütfen uzaklaşın…"

msgid "Hold still..."
msgstr "Hareketsiz durun…"
