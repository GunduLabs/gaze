msgid "Behavior"
msgstr "Chování"

msgid "Face authentication"
msgstr "Ověřování obličejem"

msgid "Enable face authentication (lock screen)"
msgstr "Povolit ověřování obličejem (zamykací obrazovka)"

msgid "Face retry mode"
msgstr "Režim opakování pokusů"

msgid "Disabled"
msgstr "Zakázáno"

msgid "Fixed tries"
msgstr "Pevný počet pokusů"

msgid "Infinite"
msgstr "Neomezeně"

msgid "Maximum face tries"
msgstr "Maximální počet pokusů"

msgid "Face authentication for unlocking this session. This does not affect the login screen. Settings are stored in this extension's configuration."
msgstr "Ověřování obličejem pro odemknutí této relace. Nemá vliv na přihlašovací obrazovku. Nastavení se ukládá do konfigurace tohoto rozšíření."

msgid "Cinnamon extension for Gaze face authentication and PolKit confirmation"
msgstr "Rozšíření Cinnamon pro ověřování obličejem Gaze a potvrzování PolKit"

msgid "Face not recognized. Please enter your password."
msgstr "Obličej nebyl rozpoznán. Zadejte heslo."

msgid "Face not detected. Please enter your password."
msgstr "Obličej nebyl zjištěn. Zadejte heslo."

msgid "Too dark for face authentication. Please enter your password."
msgstr "Na ověření obličejem je příliš tma. Zadejte heslo."

msgid "Face authentication timed out. Please enter your password."
msgstr "Čas na ověření obličejem vypršel. Zadejte heslo."

msgid "Face authentication unavailable. Please enter your password."
msgstr "Ověření obličejem není dostupné. Zadejte heslo."

msgid "Changing Gaze's settings or faces needs your password."
msgstr "Ke změně nastavení nebo obličejů Gaze je potřeba vaše heslo."

msgid "Sorry, face authentication did not work. Please try again."
msgstr "Ověření obličejem se nezdařilo. Zkuste to znovu."

msgid "You reached the maximum face authentication attempts, please try another method"
msgstr "Dosáhli jste maximálního počtu pokusů o ověření obličejem, zkuste jiný způsob"

msgid "(or look at the camera)"
msgstr "(nebo se podívejte do kamery)"

msgid "Password"
msgstr "Heslo"

msgid "Face verified. Press Enter or click Authenticate to confirm."
msgstr "Obličej ověřen. Potvrďte stiskem klávesy Enter nebo kliknutím na Ověřit."

msgid "Face authentication failed"
msgstr "Ověření obličejem selhalo"

msgid "Face authentication failed. Please enter your password."
msgstr "Ověření obličejem selhalo. Zadejte heslo."

msgid "Confirm Face Unlock"
msgstr "Potvrdit odemknutí obličejem"

msgid "Please look at the camera..."
msgstr "Podívejte se do kamery…"

msgid "Need more light..."
msgstr "Je potřeba více světla…"

msgid "Face is clipped. Please move back..."
msgstr "Obličej je oříznutý. Ustupte…"

msgid "Please center your face..."
msgstr "Umístěte obličej doprostřed…"

msgid "Please come closer..."
msgstr "Přibližte se…"

msgid "Please back up..."
msgstr "Ustupte…"

msgid "Hold still..."
msgstr "Nehýbejte se…"
