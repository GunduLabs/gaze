msgid "Behavior"
msgstr "Поведение"

msgid "Face authentication"
msgstr "Аутентификация по лицу"

msgid "Enable face authentication (lock screen)"
msgstr "Включить аутентификацию по лицу (экран блокировки)"

msgid "Face retry mode"
msgstr "Режим повторных попыток"

msgid "Disabled"
msgstr "Отключено"

msgid "Fixed tries"
msgstr "Фиксированное число попыток"

msgid "Infinite"
msgstr "Без ограничений"

msgid "Maximum face tries"
msgstr "Максимум попыток распознавания лица"

msgid "Face authentication for unlocking this session. This does not affect the login screen. Settings are stored in this extension's configuration."
msgstr "Аутентификация по лицу для разблокировки этого сеанса. Не влияет на экран входа. Настройки хранятся в конфигурации этого расширения."

msgid "Cinnamon extension for Gaze face authentication and PolKit confirmation"
msgstr "Расширение Cinnamon для аутентификации Gaze по лицу и подтверждения PolKit"

msgid "Face not recognized. Please enter your password."
msgstr "Лицо не распознано. Введите пароль."

msgid "Face not detected. Please enter your password."
msgstr "Лицо не обнаружено. Введите пароль."

msgid "Too dark for face authentication. Please enter your password."
msgstr "Слишком темно для аутентификации по лицу. Введите пароль."

msgid "Face authentication timed out. Please enter your password."
msgstr "Время аутентификации по лицу истекло. Введите пароль."

msgid "Face authentication unavailable. Please enter your password."
msgstr "Аутентификация по лицу недоступна. Введите пароль."

msgid "Changing Gaze's settings or faces needs your password."
msgstr "Для изменения настроек или лиц Gaze требуется ваш пароль."

msgid "Sorry, face authentication did not work. Please try again."
msgstr "Аутентификация по лицу не удалась. Повторите попытку."

msgid "You reached the maximum face authentication attempts, please try another method"
msgstr "Достигнуто максимальное число попыток аутентификации по лицу, попробуйте другой способ"

msgid "(or look at the camera)"
msgstr "(или посмотрите в камеру)"

msgid "Password"
msgstr "Пароль"

msgid "Face verified. Press Enter or click Authenticate to confirm."
msgstr "Лицо подтверждено. Нажмите Enter или кнопку «Аутентифицироваться» для подтверждения."

msgid "Face authentication failed"
msgstr "Ошибка аутентификации по лицу"

msgid "Face authentication failed. Please enter your password."
msgstr "Ошибка аутентификации по лицу. Введите пароль."

msgid "Confirm Face Unlock"
msgstr "Подтвердите разблокировку по лицу"

msgid "Please look at the camera..."
msgstr "Смотрите в камеру…"

msgid "Need more light..."
msgstr "Нужно больше света…"

msgid "Face is clipped. Please move back..."
msgstr "Лицо обрезано. Отодвиньтесь…"

msgid "Please center your face..."
msgstr "Поместите лицо по центру…"

msgid "Please come closer..."
msgstr "Подойдите ближе…"

msgid "Please back up..."
msgstr "Отодвиньтесь…"

msgid "Hold still..."
msgstr "Не двигайтесь…"
