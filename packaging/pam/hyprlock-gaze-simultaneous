#%PAM-1.0
# A `success=done` match ends the whole auth stack, so these gates run before
# Gaze rather than behind the `include`: otherwise a face unlock would skip the
# faillock and nologin checks that include pulls in (see gaze-kde-pam).
auth        requisite                                    pam_nologin.so
auth        requisite                                    pam_faillock.so preauth
auth        [success=done default=ignore]                pam_gaze.so simultaneous
auth        include                                      system-auth
account     include                                      system-auth
password    include                                      system-auth
session     include                                      system-auth
