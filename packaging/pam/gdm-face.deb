#%PAM-1.0
auth        required                                     pam_env.so
# Face-only, so the lockout gate has to sit in front of Gaze: nothing behind it would run.
auth        requisite                                    pam_faillock.so preauth
# Count rejected faces, not unavailable cameras or unenrolled users; only success clears failures.
auth        [success=2 auth_err=ignore default=1]         pam_gaze.so
auth        [default=die]                                pam_faillock.so authfail
auth        requisite                                    pam_deny.so
auth        required                                     pam_faillock.so authsucc
auth        required                                     pam_permit.so
auth        optional                                     pam_gnome_keyring.so use_authtok

account     required                                     pam_nologin.so
account     include                                      common-account

password    required                                     pam_deny.so

# common-session provides pam_systemd, which registers the logind
# session; without it GDM cannot complete a face-authenticated login.
session     required                                     pam_loginuid.so
session     include                                      common-session
session     optional                                     pam_gnome_keyring.so auto_start
