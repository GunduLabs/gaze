# Native x86_64 Arch build environment. Override the repository mirror to match
# an Arch derivative's snapshot, rather than mixing a current binary with old libraries.
FROM docker.io/library/archlinux:base

ARG ARCH_MIRROR=https://geo.mirror.pkgbuild.com
ARG JUST_VERSION=1.59.0
ARG NFPM_VERSION=2.49.0
# `just arch-refresh` changes this stamp to re-sync the packages instead of reusing the
# cached layer. The labels let `just arch` report how old the sync is.
ARG ARCH_SYNC=0
LABEL com.gundulabs.gaze.arch-sync="${ARCH_SYNC}" \
      com.gundulabs.gaze.arch-mirror="${ARCH_MIRROR}"

# A snapshot can be older than the base image. Downgrade the whole container to
# that repository state before installing its headers and libraries.
RUN test "$(uname -m)" = x86_64 \
    && echo "Syncing with ${ARCH_MIRROR} (stamp ${ARCH_SYNC})" \
    && printf 'Server = %s/$repo/os/$arch\n' "${ARCH_MIRROR%/}" > /etc/pacman.d/mirrorlist \
    && pacman -Syyuu --noconfirm \
    && pacman -S --needed --noconfirm \
        base-devel git ca-certificates curl unzip clang llvm openmp opencv \
        v4l-utils pam tpm2-tss gtk4 libadwaita gstreamer gst-plugins-base \
        gst-plugins-good gst-plugin-pipewire openssl pkgconf gettext nodejs \
        cmake extra-cmake-modules qt6-base qt6-declarative kcoreaddons ki18n \
        kcmutils kirigami

RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal --component rustfmt,clippy
ENV PATH=/root/.cargo/bin:$PATH

RUN set -eu; \
    url="https://github.com/casey/just/releases/download/${JUST_VERSION}"; \
    archive="just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz"; \
    curl -fsSL "$url/$archive" -o "/tmp/$archive"; \
    curl -fsSL "$url/SHA256SUMS" -o /tmp/just.sha256sums; \
    (cd /tmp && grep "  ${archive}\$" just.sha256sums | sha256sum -c -); \
    tar -xzf "/tmp/$archive" -C /usr/local/bin just; \
    rm "/tmp/$archive" /tmp/just.sha256sums

RUN set -eu; \
    url="https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}"; \
    archive="nfpm_${NFPM_VERSION}_Linux_x86_64.tar.gz"; \
    curl -fsSL "$url/$archive" -o "/tmp/$archive"; \
    curl -fsSL "$url/checksums.txt" -o /tmp/nfpm.sha256sums; \
    (cd /tmp && grep "  ${archive}\$" nfpm.sha256sums | sha256sum -c -); \
    tar -xzf "/tmp/$archive" -C /usr/local/bin nfpm; \
    rm "/tmp/$archive" /tmp/nfpm.sha256sums

ENV LLVM_CONFIG_PATH=/usr/bin/llvm-config \
    LIBCLANG_PATH=/usr/lib \
    CLANG_PATH=/usr/bin/clang \
    CXX=/usr/bin/clang++ \
    CC=/usr/bin/clang

COPY entrypoint.sh /usr/local/bin/gaze-build-entry
RUN chmod +x /usr/local/bin/gaze-build-entry
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/gaze-build-entry"]
