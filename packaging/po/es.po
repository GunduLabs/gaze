msgid "Clear a Gaze duress lockout"
msgstr "Quitar el bloqueo por coacción de Gaze"

msgid "Authentication is required to re-enable face authentication after a duress signal."
msgstr "Se requiere autenticación para volver a activar la autenticación facial después de una señal de coacción."

msgid "Manage face enrollments for Gaze"
msgstr "Gestionar los rostros registrados en Gaze"

msgid "Authentication is required to manage Gaze face enrollments."
msgstr "Se requiere autenticación para gestionar los rostros registrados en Gaze."

msgid "Manage daemon configuration for Gaze"
msgstr "Gestionar la configuración del servicio de Gaze"

msgid "Authentication is required to change Gaze daemon configuration."
msgstr "Se requiere autenticación para cambiar la configuración del servicio de Gaze."

msgid "Manage GDM login authentication for Gaze"
msgstr "Gestionar la autenticación de inicio de sesión de GDM para Gaze"

msgid "Authentication is required to change Gaze face authentication at the GDM login screen."
msgstr "Se requiere autenticación para cambiar la autenticación facial de Gaze en la pantalla de inicio de sesión de GDM."

msgid "Enroll faces and configure facial authentication"
msgstr "Registre rostros y configure la autenticación facial"

msgid "face;auth;login;biometric;"
msgstr "rostro;cara;facial;desbloqueo;autenticación;inicio de sesión;biometría;"

msgid "Enroll and manage faces, test face authentication, and adjust every Gaze setting."
msgstr "Registre y gestione rostros, pruebe la autenticación facial y ajuste toda la configuración de Gaze."

msgid "Facial authentication"
msgstr "Autenticación facial"

msgid "Gaze Settings"
msgstr "Configuración de Gaze"
