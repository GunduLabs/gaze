msgstr "Никогда (сначала RGB, затем IR)"

msgid "Auto (parallel when the camera allows it)"
msgstr "Автоматически (параллельно, если камера позволяет)"

msgid "Always (capture RGB and IR at once)"
msgstr "Всегда (RGB и IR одновременно)"

msgid "All face authentication (including sudo)"
msgstr "Вся аутентификация по лицу (включая sudo)"

msgid "Screen lockers only"
msgstr "Только блокировщики экрана"

msgid "Automatic (NPU)"
msgstr "Автоматически (NPU)"

msgid "Face the camera"
msgstr "Смотрите прямо в камеру"

msgid "Tilt your face slightly up"
msgstr "Слегка поднимите лицо вверх"

msgid "Tilt your face slightly down"
msgstr "Слегка опустите лицо вниз"

msgid "Turn your face slightly left"
msgstr "Слегка поверните лицо влево"

msgid "Turn your face slightly right"
msgstr "Слегка поверните лицо вправо"

msgid "Database error during enrollment"
msgstr "Ошибка базы данных при регистрации"

msgid "Camera error during enrollment"
msgstr "Ошибка камеры при регистрации"

msgid "Enrollment cancelled"
msgstr "Регистрация отменена"

msgid "Captured"
msgstr "Снято"

msgid "Completed"
msgstr "Завершено"

msgid "Run gaze doctor for recovery steps."
msgstr "Выполните gaze doctor, чтобы узнать, как восстановить работу."
